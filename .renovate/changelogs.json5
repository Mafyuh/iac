{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDepNames: ["mirror.gcr.io/ollama/ollama"],
      changelogUrl: "https://github.com/ollama/ollama/releases",
    },
    {
      matchDepNames: ["mirror.gcr.io/cloudflare/cloudflared"],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      matchDepNames: ["mirror.gcr.io/eceasy/cli-proxy-api"],
      changelogUrl: "https://github.com/router-for-me/CLIProxyAPI/releases",
    }
  ],
}
