{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      matchDepNames: ["ghcr.io/cyfershepard/jellystat"],
      sourceUrl: "https://github.com/CyferShepard/Jellystat",
    },
    {
      matchDepNames: ["ghcr.io/external-secrets/external-secrets"],
      sourceUrl: "https://github.com/external-secrets/external-secrets",
    },
    {
      matchDepNames: ["ghcr.io/maximhq/bifrost"],
      sourceUrl: "https://github.com/maximhq/bifrost",
    },
    {
      matchDepNames: ["ghcr.io/miguelndecarvalho/speedtest-exporter"],
      sourceUrl: "https://github.com/MiguelNdeCarvalho/speedtest-exporter",
    },
    {
      matchDepNames: ["ghcr.io/umami-software/umami"],
      sourceUrl: "https://github.com/umami-software/umami",
    },
    {
      matchDepNames: ["mirror.iac.gg/alpine/kubectl"],
      sourceUrl: "https://github.com/kubernetes/kubernetes",
    },
    {
      matchDepNames: ["mirror.iac.gg/couchdb"],
      sourceUrl: "https://github.com/apache/couchdb",
      changelogUrl: "https://docs.couchdb.org/en/stable/whatsnew/",
    },
    {
      matchDepNames: ["mirror.iac.gg/eceasy/cli-proxy-api"],
      sourceUrl: "https://github.com/router-for-me/CLIProxyAPI",
    },
    {
      matchDepNames: ["mirror.iac.gg/eeacms/postfix"],
      sourceUrl: "https://github.com/eea/eea.docker.postfix",
    },
    {
      matchDepNames: ["mirror.iac.gg/ollama/ollama"],
      sourceUrl: "https://github.com/ollama/ollama",
    },
    {
      matchDepNames: ["docker.io/library/postgres"],
      changelogUrl: "https://www.postgresql.org/docs/release/",
    },
    {
      matchDepNames: ["mirror.iac.gg/prom/graphite-exporter"],
      sourceUrl: "https://github.com/prometheus/graphite_exporter",
    },
    {
      matchDepNames: [
        "mirror.iac.gg/wazuh/wazuh-dashboard",
        "mirror.iac.gg/wazuh/wazuh-indexer",
        "mirror.iac.gg/wazuh/wazuh-manager",
      ],
      sourceUrl: "https://github.com/wazuh/wazuh",
    },
    {
      matchDepNames: ["quay.io/superq/smokeping-prober"],
      sourceUrl: "https://github.com/SuperQ/smokeping_prober",
    },
  ],
}
