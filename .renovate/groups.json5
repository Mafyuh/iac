{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Flux Group",
      groupName: "Flux",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: [
        "/flux-operator/",
        "/flux-instance/",
        "controlplaneio-fluxcd/distribution",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Wazuh",
      groupName: "Wazuh",
      matchPackageNames: [
        "/wazuh-manager/",
        "/wazuh-indexer/",
        "/wazuh-dashboard/",
      ],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "External Secrets Group",
      groupName: "External Secrets",
      matchPackageNames: ["/external-secrets/"],
      matchDatasources: ["docker", "helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Rook Ceph Group",
      groupName: "Rook Ceph",
      matchPackageNames: [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
      ],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "n8n Group",
      groupName: "n8n",
      matchPackageNames: ["/n8n-io/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cloudflare Group",
      groupName: "Cloudflare",
      matchPackageNames: ["/cloudflare/", "/cloudflared/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Immich Group",
      groupName: "Immich",
      matchPackageNames: [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning",
      ],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "SparkyFitness Group",
      groupName: "SparkyFitness",
      matchPackageNames: [
        "ghcr.io/codewithcj/sparkyfitness-server",
        "ghcr.io/codewithcj/sparkyfitness-frontend",
      ],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
  ],
}
