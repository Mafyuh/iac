{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Talos version management",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["siderolabs/talos"],
      versioning: "semver",
    },
    {
      description: "release prefix",
      matchDatasources: ["docker"],
      matchPackagePatterns: [
        "^ghcr\\.io/hotio/.+",
        "^ghcr\\.io/lukegus/termix$",
      ],
      versioning: "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "SearXNG calver with commit suffix",
      matchDatasources: ["docker"],
      matchPackageNames: ["/searxng/searxng/"],
      versioning: "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$",
    },
  ],
}
